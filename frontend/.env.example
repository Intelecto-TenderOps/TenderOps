# Leave empty to use same-origin /api (Vite proxy or a Vercel rewrite).
# Set only a real Azure Functions origin when the browser calls Azure directly.
# Example: https://tenderops-prod-func.azurewebsites.net
VITE_API_BASE_URL=

# true = call /api on the Vite proxy / Vercel rewrite even without VITE_API_BASE_URL
VITE_USE_AZURE_API=false

# true = keep the in-browser demonstration store
VITE_FORCE_DEMO=true

# Public Entra SPA values only. Never put Function Keys or client secrets here.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=

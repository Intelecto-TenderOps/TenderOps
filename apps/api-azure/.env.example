# Azure Functions / platform
TENDEROPS_ENVIRONMENT=development
AZURE_FUNCTIONS_BASE_URL=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
FUNCTIONS_WORKER_RUNTIME=node

# Local/dev only. Forbidden in production.
DEMO_ENABLED=true
STORAGE_MODE=Memory
DEMO_TOKEN_SECRET=local-dev-only-change-me

# Microsoft Entra ID
AZURE_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=api://tenderops/access
ENTRA_SERVICE_CLIENT_ID=

# Dataverse
DATAVERSE_URL=
DATAVERSE_ENVIRONMENT_ID=
DATAVERSE_SOLUTION_NAME=TenderOpsFoundation
DATAVERSE_PUBLISHER_PREFIX=tno
DATAVERSE_METADATA_VERIFIED=false

# Dynamics 365 Sales
DYNAMICS_BASE_URL=
DYNAMICS_ENVIRONMENT_ID=

# SharePoint / Graph
SHAREPOINT_SITE_URL=https://intelecto1.sharepoint.com/sites/intelectocrm
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_LIBRARY_NAME=Cuenta

# Copilot Studio
COPILOT_ENVIRONMENT_ID=
COPILOT_ORCHESTRATOR_AGENT_ID=
COPILOT_VIABILITY_AGENT_ID=
COPILOT_STRATEGY_AGENT_ID=
COPILOT_OBSERVATIONS_AGENT_ID=
COPILOT_DOCUMENT_AGENT_ID=
COPILOT_CANDIDATES_AGENT_ID=

# SECOP / datos.gov.co
SECOP_II_DATASET_ID=p6dx-8zbt
SECOP_I_DATASET_ID=f789-7hwg
SOCRATA_APP_TOKEN=
SECOP_RETENTION_DAYS=90
SECOP_SYNC_SCHEDULE=0 0 * * * *
SECOP_MONITORED_SCHEDULE=0 0 * * * *
SECOP_SEARCH_SCHEDULE=0 0 * * * *
DYNAMICS_RECONCILE_SCHEDULE=0 0 */4 * * *
DOCUMENT_EXPIRY_SCHEDULE=0 0 6 * * *
TASK_DEADLINE_SCHEDULE=0 15 6 * * *
CLEANUP_SCHEDULE=0 30 6 * * *
SECOP_SYNC_BATCH_SIZE=100
SECOP_MAX_REQUESTS_PER_RUN=20
SECOP_CATALOG_MAX_PER_RUN=500

# CORS — only authorized browser origins
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend is configured separately. Never put Function Keys or admin secrets in VITE_*.
